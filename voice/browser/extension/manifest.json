{
  "manifest_version": 3,
  "name": "Local Voice Browser",
  "version": "0.4.7",
  "description": "Local voice actions on the active website. Hold Option and speak. No cloud connection.",
  "permissions": [
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Local Voice \u00b7 automatic website control"
  },
  "key": "",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
